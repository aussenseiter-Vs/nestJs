{
  "info": {
    "name": "Habit Tracker API",
    "description": "A habit tracking application with JWT auth, CRUD habits, check-ins, and stats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "habit_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"jwt\", json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Habits",
      "item": [
        {
          "name": "Create Habit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"habit_id\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Exercise\",\n  \"description\": \"30 min workout\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/habits",
              "host": ["{{base_url}}"],
              "path": ["habits"]
            }
          }
        },
        {
          "name": "List Habits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits",
              "host": ["{{base_url}}"],
              "path": ["habits"]
            }
          }
        },
        {
          "name": "Get Habit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}"]
            }
          }
        },
        {
          "name": "Update Habit",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Morning Exercise\",\n  \"description\": \"45 min workout\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}"]
            }
          }
        },
        {
          "name": "Delete Habit",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Check-ins",
      "item": [
        {
          "name": "Create Check-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Felt great today!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}/checkins",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}", "checkins"]
            }
          }
        },
        {
          "name": "List Check-ins",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}/checkins",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}", "checkins"]
            }
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Get Habit Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/habits/{{habit_id}}/stats",
              "host": ["{{base_url}}"],
              "path": ["habits", "{{habit_id}}", "stats"]
            }
          }
        }
      ]
    }
  ]
}
